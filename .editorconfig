root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json,md}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
# System directives
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = true

# Braces
csharp_new_line_before_open_brace = all
csharp_new_line_before_open_braces = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true
csharp_new_line_before_members_in_anonymous_types = true
csharp_new_line_before_members_in_object_initializers = true
csharp_new_line_before_query_expression_clauses = true

# Indentation
csharp_indent_block_contents = true
csharp_indent_braces_normally = false
csharp_indent_case_labels = true
csharp_indent_case_when_block = true
csharp_indent_switch_labels = true

# Spacing
csharp_space_after_cast = false
csharp_space_after_colon_in_struct_interfaces = true
csharp_space_after_colon_in_struct_interfaces_in_attributes = true
csharp_space_after_comma = true
csharp_space_after_dot = false
csharp_space_after_keywords = true
csharp_space_after_semicolon = true
csharp_space_around_unary_operator = false
csharp_space_before_colon_in_struct_interfaces = true
csharp_space_before_colon_in_struct_interfaces_in_attributes = true
csharp_space_before_comma = false
csharp_space_before_dot = false
csharp_space_before_semicolon = false
csharp_space_between_parentheses = false
csharp_space_between_method_call_empty_parentheses = false
csharp_space_between_method_call_parentheses = false
csharp_space_between_method_declaration_empty_parentheses = false
csharp_space_between_method_declaration_parentheses = false
csharp_space_between_parentheses_in_expression = false

# Style preferences
csharp_style_pattern_matching_over_is_with_cast_only = false
csharp_style_expression_bodied_methods = true
csharp_style_expression_bodied_constructors = true
csharp_style_expression_bodied_properties = true
csharp_style_expression_bodied_indexers = true
csharp_style_expression_bodied_accessors = true
csharp_style_expression_bodied_lambdas = true
csharp_style_expression_bodied_local_functions = true
csharp_style_conditional_for_return = true
csharp_style_conditional_for_void_check = true
csharp_style_prefer_primary_constructors = true
csharp_style_prefer_compound_assignment = true
csharp_style_prefer_simple_interpolation = true
csharp_style_prefer_file_scoped_namespace = true
csharp_style_namespace_match_folder = false

# Analyzer severity — treat violations as build warnings
dotnet_diagnostic.CA1014.severity = warning
dotnet_diagnostic.CA1024.severity = warning
dotnet_diagnostic.CA1032.severity = warning
dotnet_diagnostic.CA1034.severity = warning
dotnet_diagnostic.CA1055.severity = warning
dotnet_diagnostic.CA1716.severity = warning
dotnet_diagnostic.CA2007.severity = warning
dotnet_diagnostic.CA2016.severity = warning
dotnet_diagnostic.CA2201.severity = warning
dotnet_diagnostic.CA2214.severity = warning
dotnet_diagnostic.CA2225.severity = warning
dotnet_diagnostic.CA2229.severity = warning
dotnet_diagnostic.CA2234.severity = warning
dotnet_diagnostic.CA2241.severity = warning
dotnet_diagnostic.CA2242.severity = warning

